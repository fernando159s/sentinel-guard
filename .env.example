# ============================================================
# SecuriForm — Variables de entorno
# Copiar este archivo a .env y completar los valores
# NUNCA commitear .env al repositorio
# ============================================================

# ------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------
APP_NAME=SecuriForm
APP_ENV=development          # development | production
APP_DEBUG=true               # false en producción
APP_URL=http://localhost      # URL completa sin slash final ← CAMBIAR
APP_TIMEZONE=America/Lima

# Clave secreta para CSRF y tokens (mínimo 32 caracteres aleatorios)
APP_SECRET=cambia_esto_por_una_cadena_aleatoria_de_32_caracteres_minimo  # ← CAMBIAR

# ------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securiform            # ← CAMBIAR: nombre de tu BD
DB_USER=root                  # ← CAMBIAR: usuario MySQL del hosting
DB_PASS=                      # ← CAMBIAR: contraseña MySQL
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
# EMAIL (SMTP)
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com      # ← CAMBIAR según tu proveedor
MAIL_PORT=587
MAIL_USERNAME=               # ← CAMBIAR: tu email
MAIL_PASSWORD=               # ← CAMBIAR: contraseña o app password
MAIL_ENCRYPTION=tls          # tls | ssl | none
MAIL_FROM_ADDRESS=noreply@tudominio.com  # ← CAMBIAR
MAIL_FROM_NAME=SecuriForm

# ------------------------------------------------------------
# RUTAS DE ARCHIVOS
# ------------------------------------------------------------
# Ruta absoluta al directorio raíz de la aplicación (sin slash final)
# Ejemplo Linux hosting: /home/tuusuario/securiform
# Ejemplo Windows local: C:/xampp/htdocs/securiform
APP_ROOT=/var/www/securiform  # ← CAMBIAR

# Ruta absoluta al directorio de uploads (debe ser escribible)
UPLOAD_PATH=/var/www/securiform/uploads  # ← CAMBIAR

# Tamaño máximo de archivos en bytes (5 MB = 5242880)
MAX_UPLOAD_SIZE=5242880

# ------------------------------------------------------------
# SESIONES
# ------------------------------------------------------------
SESSION_LIFETIME=480         # Minutos de inactividad antes de expirar (8 horas)
SESSION_NAME=securiform_sess

# ------------------------------------------------------------
# INTEGRACIÓN LINEAR (solo para desarrollo)
# ------------------------------------------------------------
LINEAR_API_KEY=              # lin_api_XXXXXXXXXXXXXXXX
LINEAR_TEAM_ID=              # UUID del team en Linear

# ------------------------------------------------------------
# CONFIGURACIÓN OPCIONAL
# ------------------------------------------------------------
# Número de registros por página en listados
PAGINATION_LIMIT=20

# Días que un usuario puede reabrir un ticket resuelto
TICKET_REOPEN_DAYS=7

# Intentos de login antes de bloqueo temporal
LOGIN_MAX_ATTEMPTS=5

# Minutos de bloqueo tras intentos fallidos
LOGIN_LOCKOUT_MINUTES=15
